    font-weight: 300;
    color: var(--pearl);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(63, 117, 102, 0.35), transparent 60%),
      radial-gradient(ellipse at 50% 120%, rgba(0, 0, 0, 0.8), transparent 60%),
      var(--lagoon);
    background-attachment: fixed;
  }

