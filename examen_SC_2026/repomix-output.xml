  .monsters-table thead a:hover { color: var(--pearl); }
  .monsters-table tbody tr { border-top: 1px solid rgba(63, 117, 102, 0.4); }
  .monsters-table tbody tr:nth-of-type(even) { background: rgba(239, 234, 224, 0.03); }

  /* Affichage conditionnel : NE PAS MODIFIER */
  .monsters-table tr:not(.isEditing) .isEditing-visible {
    display: none;
  }
  .monsters-table tr.isEditing .isEditing-hidden {
    display: none;
  }
